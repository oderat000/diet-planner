# This app needs no API keys.
#
# Nutrition: USDA FoodData Central (SR Legacy) is bundled with the app in
# src/data/usda-foods.json — every calorie and macro figure is a real USDA
# measurement, looked up locally. No key, no network, no rate limit.
# To rebuild that table from the USDA source release:
#     node --max-old-space-size=4096 scripts/build-usda-table.mjs
#
# Recipes, photos and cooking videos come from TheMealDB, which needs no key.
#
# OPTIONAL AI add-ons (dish photo recognition + the diet Q&A assistant).
# The core planner works without this; these two features switch off cleanly if it's unset.
# Free key, email only, no card: https://aistudio.google.com/apikey
# Gemini recognises ingredients / answers questions; calorie numbers still come from USDA.
#
# Stays server-side: these two routes (src/app/api/analyze-dish, src/app/api/ask) run on
# Vercel, never in the browser. If you're serving the rest of the app statically (e.g.
# GitHub Pages), point NEXT_PUBLIC_API_BASE_URL at that Vercel deployment.
GEMINI_API_KEY=
# Optional model override (defaults to gemini-flash-latest):
# GEMINI_MODEL=gemini-flash-latest

# Only needed when the pages and the API are served from different origins, e.g. the
# static site is on GitHub Pages and the AI routes are on Vercel. Leave unset for a
# same-origin deployment (both pages and API on Vercel).
# NEXT_PUBLIC_API_BASE_URL=https://your-project.vercel.app

# Per-IP rate limit on the AI routes (10 requests/hour/IP), so a scraper hitting the
# public endpoint directly can't run up your Gemini bill. Free database, no card:
# https://console.upstash.com — create a Redis database and copy its REST credentials.
# Left unset, the AI routes work with no cap at all — but ACCOUNTS REQUIRE THIS: users,
# sessions and the activity log all live in the same Upstash database, and auth fails
# closed (hard error) rather than letting requests through when it's missing.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# ACCOUNTS (optional — the planner works fully signed-out)
# ---------------------------------------------------------------------------

# Secret salt mixed into the stored hashes of email addresses and IP addresses, so a
# database dump can't be reversed with a rainbow table of common emails. Generate with:
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# CHANGING THIS INVALIDATES EVERY EXISTING LOGIN — the email index is keyed on it.
# AUTH_PEPPER=

# Absolute origin used to build the links in confirmation emails. Required in production:
# without it the app falls back to the request's Host header, which is attacker-controlled
# and is only accepted for localhost and *.vercel.app.
# AUTH_URL=https://your-project.vercel.app

# Sending confirmation emails. Unset, links are printed to the server console instead,
# which is fine for local development. Free tier, no card: https://resend.com
# The from-address must be on a domain you've verified with Resend.
# RESEND_API_KEY=
# AUTH_EMAIL_FROM=Diet Planner <noreply@your-domain.com>

# Comma-separated user ids allowed to read the site-wide activity feed at /admin/activity.
# Find an id in the Upstash console under user:email:<hash>, or leave unset for nobody.
# AUTH_ADMIN_USER_IDS=
